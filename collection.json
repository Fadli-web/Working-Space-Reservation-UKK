      "description": "Endpoint registrasi, login, dan pengelolaan profil pengguna.",
      "item": [
        {
          "name": "Register Member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-maker-key",
                "value": "{{maker_key}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"member_baru\",\n  \"password\": \"password123\",\n  \"nama_member\": \"Anton Eka Putra\",\n  \"instansi\": \"SMK Telkom Malang\",\n  \"alamat\": \"Jl. Danau Ranau, Sawojajar, Malang\",\n  \"telp\": \"081234567890\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/member",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register", "member"]
            },
            "description": "Mendaftarkan akun baru dengan role 'member'."
          },
          "response": []
        },
        {
          "name": "Register Admin Space",
