              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register", "admin-space"]
            },
            "description": "Mendaftarkan akun baru pemilik/pengelola gedung coworking dengan role 'admin_space'."
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    if (res.data && res.data.access_token) {",
                  "        pm.collectionVariables.set('token', res.data.access_token);",
                  "        console.log('Access token otomatis disimpan ke collection variable!');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-maker-key",
                "value": "{{maker_key}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"anton\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login untuk Member & Admin Space. Token JWT otomatis disimpan ke variabel `token`."
          },
          "response": []
        },
        {
          "name": "Get Profile Pengguna Login",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
